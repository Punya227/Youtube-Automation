# Copy to .env and fill in. Never commit .env.

# "mock" simulates uploads locally (safe default). "live" uploads to YouTube.
UPLOAD_MODE=mock

# Password for the local dashboard (leave empty to disable the login screen).
DASHBOARD_PASSWORD=

# Google OAuth Desktop client file downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json
# Encrypted (Windows DPAPI) OAuth token written after "Connect YouTube account".
YOUTUBE_TOKEN_FILE=secrets/youtube_token.bin

# Optional: AI metadata generation. Without a key a local template is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional tuning
# YSA_DATA_DIR=youtube_shorts
# SHORTS_MAX_DURATION_SECONDS=180
# ALLOWED_EXTENSIONS=.mp4,.mov,.m4v
# FILE_STABLE_SECONDS=10
# SCAN_INTERVAL_SECONDS=15
# UPLOAD_CHUNK_MB=8
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# LOG_LEVEL=INFO

# Mock-mode failure injection for testing recovery:
# transient_once | transient_always | permanent | auth | quota | crash_after_upload | interrupt_midway | drop_publish_at
# MOCK_FAIL_MODE=
